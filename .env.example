SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
ALERT_TO=recipient@example.com

POLL_MINUTES=30
PROFILE_DIR=.playwright-profile
SEEN_SLOTS_FILE=seen_slots.json
MANUAL_CAPTCHA_TIMEOUT_SECONDS=900
CAPTCHA_OCR_MODE=off
DEMARCHE_DELAY_SECONDS=30
BLOCK_BACKOFF_MINUTES=120
